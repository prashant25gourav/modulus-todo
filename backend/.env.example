# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection String (placeholder only - replace in local .env)
MONGODB_URI=mongodb://localhost:27017/modulus_todo

# CORS Allowed Origin
CORS_ORIGIN=http://localhost:8081

# JWT Authentication (min 32 characters for security)
JWT_ACCESS_SECRET=your_32_character_minimum_random_secret_here_12345
ACCESS_TOKEN_TTL=15m

# Authentication Rate Limiting
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=20

# Refresh Token & Session Management
REFRESH_TOKEN_TTL_DAYS=30
REFRESH_GRACE_SECONDS=10
REFRESH_RATE_LIMIT_MAX=60
REFRESH_RATE_LIMIT_WINDOW_MS=900000
